# ─── Telegram ───────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAAA-your-bot-token-here

# YOUR Telegram numeric user ID (the ONLY person the bot will respond to)
# Get it from @userinfobot on Telegram
OWNER_ID=123456789

# ─── GitHub OAuth App ───────────────────────────────────────
# Create at: https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL MUST be: {BASE_URL}/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ─── Server ─────────────────────────────────────────────────
# Public base URL of this deployment (Railway gives you one, e.g.
# https://gitrohub-production.up.railway.app) — NO trailing slash
BASE_URL=https://your-app.up.railway.app
PORT=3000

# ─── Security ───────────────────────────────────────────────
# Random long strings — generate with: openssl rand -hex 32
SESSION_JWT_SECRET=replace_with_random_64_char_hex_string
TOKEN_ENCRYPTION_KEY=replace_with_random_32_byte_hex_string

# ─── Database (Railway Postgres plugin provides this automatically) ─
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── Redis (Railway Redis plugin provides this automatically) ─
REDIS_URL=redis://default:password@host:6379

# ─── Misc ───────────────────────────────────────────────────
# Bot version shown in Settings — bump manually per release
BOT_VERSION=0.8.7

# ─── Memory management (optional — sensible defaults for Railway free tier) ─
# Node's V8 heap cap in MB. Set via NODE_OPTIONS (not a code flag) so this
# can be tuned per-plan without a redeploy — e.g. bump it up if you move off
# the free tier's 512MB limit. 384 leaves ~128MB headroom for buffers/native
# overhead that live outside V8's heap. REQUIRED on Railway's free tier —
# without this, Node doesn't know the container's real limit and can get
# hard-killed by the kernel instead of garbage-collecting proactively.
NODE_OPTIONS=--max-old-space-size=384

# Max Postgres pool connections (single-owner bot doesn't need many)
PG_POOL_MAX=3
# RSS threshold (MB) that triggers a self-imposed clean restart, comfortably
# under your Railway plan's actual memory limit (free tier = 512MB)
MEMORY_WATCHDOG_MB=400
# How long ctx.session state (currently viewed repo, bulk selections, etc.)
# survives in Redis with no activity before it's cleared. Optional — falls
# back to 24h if unset.
SESSION_TTL_SECONDS=86400

# ─── Security ────────────────────────────────────────────────
# Verifies incoming Telegram webhook requests actually came from Telegram,
# not a forged POST to a guessed URL. Generate with: openssl rand -hex 24
# Strongly recommended on Railway (public URL) — optional in local dev
# (polling mode doesn't use a webhook at all).
TELEGRAM_WEBHOOK_SECRET=replace_with_random_hex_string
